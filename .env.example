# ==============================================================================
# Jadoo + HeadMouseAI Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your personal API keys if cloud features
# are desired. The application will operate 100% offline if no keys are provided.
# ==============================================================================

# --- AI Cloud Providers (Optional) ---
# Groq Cloud Whisper STT API Key (whisper-large-v3-turbo)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (gemini-2.5-flash for desktop task planning & assistance)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Speech Recognition (STT) Settings ---
# Options: "cloud_first" (Default: Groq with local whisper.cpp fallback),
#          "offline" (Local whisper.cpp only),
#          "cloud" (Groq only)
JADOO_STT_MODE=cloud_first

# Default Dictation Language: "en", "hi", "hinglish", or "auto"
JADOO_VOICE_LANG=en

# --- Accessibility & UI Settings ---
# Text-to-Speech audio response using Windows SAPI (true/false)
JADOO_TTS_ENABLED=false

# Reduce Motion: Disables breathing animations and pulsing timers for low CPU or accessibility
JADOO_REDUCE_MOTION=false

# High Contrast mode
JADOO_HIGH_CONTRAST=true

# Automatically listen for voice commands on launch (true/false)
JADOO_AUTO_LISTEN=true
